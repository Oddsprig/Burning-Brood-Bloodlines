; Engine configuration file.
config_version=5

[application]

config/use_custom_user_dir=true
config/custom_user_dir_name="Burning Brood Bloodlines Claude Edition"

config/name="Burning Brood: Bloodlines - Claude Edition"
config/version="0.072-claude"
config/quit_on_go_back=false
config/icon="res://icon_claude.png"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.0823529, 0.0627451, 0.0509804, 1)
boot_splash/image="res://icon_mobile/splash.png"
boot_splash/fullsize=false
boot_splash/show_image=true

[autoload]

DB="*res://core/db.gd"
Game="*res://core/game.gd"
Perf="*res://core/perf_tracker.gd"
Sound="*res://core/sound.gd"
MobileApp="*res://core/mobile_app.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/min_width=320
window/size/min_height=320
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

